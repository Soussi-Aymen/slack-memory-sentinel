# ContextDrift environment template.
# Copy to .env and fill in the secrets. .env is gitignored and never committed.

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Qdrant ---------------------------------------------------------------
# Inside the compose network Qdrant is reachable by service name, not localhost.
VECTOR_DB_URL=http://qdrant:6333
# Host-side alternative, for running scripts outside compose:
# VECTOR_DB_URL=http://localhost:6333

# --- Corpus ---------------------------------------------------------------
DATA_PATH=/app/data/mock_slack_data.json

# --- GitHub ---------------------------------------------------------------
# Personal access token with `repo` scope, used for issues and PRs via the REST API.
GH_TOKEN=ghp_your_token_here

# --- Cognee 1.5 Slack integration -----------------------------------------
# 1.5.0.dev1 defaults to multi-tenant auth. Keep this false so the existing
# single-user "slack" dataset stays readable by /cognee-ask and the web UI.
ENABLE_BACKEND_ACCESS_CONTROL=false

# AES-256-GCM key for stored Slack OAuth tokens. 32 random bytes, base64:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
INTEGRATION_CREDENTIALS_KEY=

# From api.slack.com → your app → Basic Information.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Must byte-match the Slack app manifest redirect URL (the ngrok hostname).
SLACK_REDIRECT_URI=https://YOUR_NGROK_HOST/api/v1/integrations/slack/callback

# Where the browser lands after OAuth. Localhost is correct even when Slack
# talks to the backend through ngrok.
SLACK_FRONTEND_BASE_URL=http://localhost:8000
